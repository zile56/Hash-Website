# =============================================================================
# Hash Website — Environment Configuration
# =============================================================================
# Copy this file to .env.local for local overrides.
#
# Client-Side Public Variables (Vite bundles these into the client):
# -----------------------------------------------------------------------------
VITE_CONTACT_TO_EMAIL=contact@hash.engineering
VITE_CALENDLY_URL=https://calendly.com/hash-engineering/technical-discovery
VITE_DEFAULT_WEBMAIL=gmail

# Server-Side Variables (Vercel Serverless Function / api/contact.js):
# -----------------------------------------------------------------------------
# NEVER prefix secret keys with VITE_. Set these in your Vercel Project Settings
# or production deployment environment.
#
# 1. Resend API Key: Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_1234567890abcdef

# 2. Sender Address: Must be a verified domain in Resend
CONTACT_FROM_EMAIL=Hash Engineering <contact@hash.engineering>

# 3. Destination Inbox: Where technical scope briefs are routed
CONTACT_TO_EMAIL=contact@hash.engineering
